# Caddy loopback HTTP proxy for the ALCF Agent dashboard.
#
# Why: the dashboard's chat is an xterm terminal that uses the browser Clipboard
# API. Browsers treat the documented http://localhost URL as a trustworthy
# secure context, so clipboard access works without TLS. The host MUST publish
# this port on 127.0.0.1 only; the documented Docker command does.
#
# ${ALCF_DASHBOARD_PORT} and ${ALCF_DASHBOARD_INTERNAL_PORT} are substituted by
# the entrypoint at start.

{
	admin off
}

http://localhost:${ALCF_DASHBOARD_PORT}, http://127.0.0.1:${ALCF_DASHBOARD_PORT} {
	# WebSocket + streaming friendly; the dashboard chat uses a WS PTY.
	reverse_proxy 127.0.0.1:${ALCF_DASHBOARD_INTERNAL_PORT}
}
