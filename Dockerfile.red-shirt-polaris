# Red Shirt Polaris: dedicated compute image (no dashboard entrypoint).
#
# Extends the pinned, immutable Hermes Agent base by tag+digest and adds
# a pinned Tailscale binary set for userspace tailnet transport. This image
# is deliberately minimal: it carries only what the resident Polaris compute
# agent needs (entrypoint, config, probes, docs, skills) and never the
# laptop/dashboard image's Caddy/HTTPS dashboard stack.
#
# Base pin provenance (recorded 2026-09-16):
#   nousresearch/hermes-agent:v2026.9.14
#   OCI index digest: sha256:99641e57ec762c59e54cb44aa6746b7fc68c18b3c5ddb088af54234c613d9294
#   linux/amd64 manifest digest: sha256:1f983df4d778d46b3c3892d7598c9d57291430a6e35936ebc371ae1e5766699a
#   linux/arm64 manifest digest: sha256:011f2e232f119a9601cf6525f7542921d758703c7771ce2f7b639a07fa8640d1
#   Verified via `GET /v2/nousresearch/hermes-agent/manifests/v2026.9.14`
#   with Accept: application/vnd.oci.image.index.v1+json against
#   registry-1.docker.io; both architectures present in the index.
ARG HERMES_BASE=nousresearch/hermes-agent:v2026.9.14@sha256:99641e57ec762c59e54cb44aa6746b7fc68c18b3c5ddb088af54234c613d9294

# Tailscale binaries pinned to the release already verified in the transport
# proof (v1.88.3). Digest is the previously verified/recorded release digest.
FROM tailscale/tailscale:v1.88.3@sha256:b2a19f6b6402adc26a2aa8cb90da66afe3061e718ac67ed3f21ec3d4b366439f AS tailscale-src

FROM ${HERMES_BASE}
USER root

COPY --from=tailscale-src /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale-src /usr/local/bin/tailscaled /usr/local/bin/tailscaled

# The ALCF token helper imports globus_sdk at job startup. The pinned Hermes
# base does not ship it, so install it into the same interpreter Hermes uses.
RUN uv pip install --python /opt/hermes/.venv/bin/python --no-cache globus-sdk

# The pinned standard A2A client uses urllib without proxy support. Polaris
# userspace Tailscale has no kernel route, so add a fail-closed per-peer proxy
# path: a proxy is usable only with an exact configured destination authority.
COPY scripts/patch_hermes_a2a_proxy.py /tmp/patch_hermes_a2a_proxy.py
RUN /opt/hermes/.venv/bin/python /tmp/patch_hermes_a2a_proxy.py \
      /opt/hermes/plugins/platforms/a2a/tools.py \
    && /opt/hermes/.venv/bin/python -m py_compile /opt/hermes/plugins/platforms/a2a/tools.py \
    && rm /tmp/patch_hermes_a2a_proxy.py

# Later-task deliverables (entrypoint, config renderer, probes, SOUL, docs
# snapshot) do not exist at this task. This COPY set matches the plan's file
# map exactly; the build will fail once those paths exist but are wrong, and
# this Dockerfile's own tests are static-content tests that do not build the
# image, so they do not require these paths to be present yet.
COPY scripts/connect_proxy.py /opt/red-shirt-polaris/connect_proxy.py
COPY scripts/alcf_combined_auth.py /opt/red-shirt-polaris/alcf_combined_auth.py
COPY scripts/populate_models.py /opt/red-shirt-polaris/populate_models.py
COPY scripts/resolve_context_length.py /opt/red-shirt-polaris/resolve_context_length.py
COPY scripts/red_shirt_config.py /opt/red-shirt-polaris/red_shirt_config.py
COPY scripts/red_shirt_probe.py /opt/red-shirt-polaris/red_shirt_probe.py
COPY scripts/red_shirt_task_context.py /opt/red-shirt-polaris/red_shirt_task_context.py
COPY scripts/red_shirt_campaign.py /opt/red-shirt-polaris/red_shirt_campaign.py
COPY scripts/red_shirt_host_bridge.sh /opt/red-shirt-polaris/red_shirt_host_bridge.sh
COPY scripts/red_shirt_host_client.sh /opt/red-shirt-polaris/red_shirt_host_client.sh
COPY scripts/red_shirt_host_watcher.sh /opt/red-shirt-polaris/red_shirt_host_watcher.sh
COPY scripts/red_shirt_rank_wrapper.sh /opt/red-shirt-polaris/red_shirt_rank_wrapper.sh
COPY scripts/red_shirt_gpu_rank_probe.py /opt/red-shirt-polaris/red_shirt_gpu_rank_probe.py
COPY scripts/red_shirt_entrypoint.sh /opt/red-shirt-polaris/entrypoint.sh
COPY config/red-shirt-polaris/ /opt/red-shirt-polaris/config/
COPY docs/polaris-snapshot/ /opt/red-shirt-polaris/docs/
COPY config/red-shirt-polaris/skills/ /opt/red-shirt-polaris/skills/

RUN chmod 0555 \
      /opt/red-shirt-polaris/entrypoint.sh \
      /opt/red-shirt-polaris/red_shirt_host_bridge.sh \
      /opt/red-shirt-polaris/red_shirt_host_client.sh \
      /opt/red-shirt-polaris/red_shirt_host_watcher.sh \
      /opt/red-shirt-polaris/red_shirt_rank_wrapper.sh \
      /opt/red-shirt-polaris/red_shirt_gpu_rank_probe.py \
    && chown -R hermes:hermes /opt/red-shirt-polaris

# Dedicated, non-root-readable mountpoint for the read-only secret/CA bind
# (see deploy/polaris/red-shirt-polaris.pbs: --bind "$SECRETS_DIR:/mnt/secrets:ro").
# Apptainer refuses to bind onto a destination absent from the read-only SIF,
# so this directory must exist in the image itself, not merely be
# allowlisted by the launcher's own tests. It is a standalone top-level
# path -- not nested under /opt/red-shirt-polaris (application content) or
# /opt/data (the persistent HERMES_HOME bind target) -- so the read-only
# secrets bind can never shadow either.
RUN mkdir -p /mnt/secrets && chmod 0755 /mnt/secrets

# Bake the source commit so the running agent can report unambiguous
# provenance (CI passes ALCF_GIT_SHA=${{ github.sha }}; local builds default
# to "dev").
ARG ALCF_GIT_SHA=dev
RUN printf '%s\n' "$ALCF_GIT_SHA" > /opt/red-shirt-polaris/REVISION

ENV HERMES_HOME=/opt/data A2A_HOST=127.0.0.1 A2A_PORT=9900 A2A_AGENT_NAME="Red Shirt Polaris"

USER hermes
WORKDIR /opt/data
ENTRYPOINT ["/opt/red-shirt-polaris/entrypoint.sh"]
