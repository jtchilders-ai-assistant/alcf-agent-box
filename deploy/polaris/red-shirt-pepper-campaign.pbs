#!/bin/bash
#PBS -N red-shirt-pepper
#PBS -l select=2:system=polaris
#PBS -q debug
#PBS -l walltime=02:00:00
#PBS -l filesystems=home

# One bounded, autonomous Pepper campaign attempt. Submit with an explicit
# project: qsub -A datascience deploy/polaris/red-shirt-pepper-campaign.pbs
set -euo pipefail
umask 077

BASE_DIR="${BASE_DIR:-$HOME/red-shirt-polaris}"
HERMES_HOME_DIR="${HERMES_HOME_DIR:-$BASE_DIR/home}"
SIF="${SIF:?Set SIF to the verified digest-pinned Red Shirt SIF}"
MAX_ATTEMPTS="${MAX_ATTEMPTS:-1}"
HERMES_TIMEOUT="${HERMES_TIMEOUT:-6000}"
JOB_ID="${PBS_JOBID:-manual-$$}"
JOB_SHORT="${JOB_ID%%.*}"
CAMPAIGN_ROOT="$HERMES_HOME_DIR/campaigns/pepper-gpu-8rank"
LEDGER="$CAMPAIGN_ROOT/attempt-ledger"
LOCK_FILE="$CAMPAIGN_ROOT/attempt-ledger.lock"
TOOLS="$BASE_DIR/campaign-tools"
MPI_ENV_HELPER="${MPI_ENV_HELPER:-$TOOLS/red_shirt_mpi_env.sh}"
ATTEMPT=""
WATCHER_PID=""
RUN8_LAUNCHER=""

mkdir -p "$CAMPAIGN_ROOT"
chmod 700 "$CAMPAIGN_ROOT"
command -v flock >/dev/null 2>&1 || { printf 'ERROR: flock is required\n' >&2; exit 69; }
exec 9>"$LOCK_FILE"
flock -n 9 || { printf 'ERROR: another campaign attempt is active\n' >&2; exit 75; }
case "$MAX_ATTEMPTS" in ''|*[!0-9]*|0) printf 'ERROR: MAX_ATTEMPTS must be positive\n' >&2; exit 2;; esac
attempt_number=1
if [ -s "$LEDGER" ]; then attempt_number=$(( $(wc -l < "$LEDGER") + 1 )); fi
if [ "$attempt_number" -gt "$MAX_ATTEMPTS" ]; then
  printf 'ERROR: attempt cap reached (%s)\n' "$MAX_ATTEMPTS" >&2
  exit 76
fi
attempt_id="$(printf '%03d' "$attempt_number")"
ATTEMPT="$CAMPAIGN_ROOT/attempts/$attempt_id"
TASK="$ATTEMPT/task"
RUNTIME="$ATTEMPT/runtime"
BRIDGE="$ATTEMPT/bridge"
PROBE_WORK="$ATTEMPT/toolchain"
mkdir -p "$TASK" "$RUNTIME" "$BRIDGE" "$PROBE_WORK"
printf '%s\t%s\t%s\n' "$attempt_id" "$JOB_ID" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LEDGER"

cleanup() {
  local rc="$?"
  set +e
  if [ -n "$ATTEMPT" ] && [ -d "$BRIDGE" ]; then touch "$BRIDGE/STOP"; fi
  if [ -n "$WATCHER_PID" ] && kill -0 "$WATCHER_PID" 2>/dev/null; then
    kill -TERM "$WATCHER_PID" 2>/dev/null || true
    for _ in $(seq 1 10); do
      kill -0 "$WATCHER_PID" 2>/dev/null || break
      sleep 1
    done
    kill -KILL "$WATCHER_PID" 2>/dev/null || true
    wait "$WATCHER_PID" 2>/dev/null || true
  fi
  if [ -n "$ATTEMPT" ]; then
    printf '{"pbs_job_id":"%s","wrapper_exit_code":%s,"ok":%s}\n' \
      "$JOB_ID" "$rc" "$([ "$rc" -eq 0 ] && printf true || printf false)" \
      >"$RUNTIME/pbs-terminal.json"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Verify the immutable SIF before any container execution.
test -r "$SIF" || { printf 'ERROR: missing SIF: %s\n' "$SIF" >&2; exit 1; }
test -r "${SIF}.sha256" || { printf 'ERROR: missing checksum sidecar\n' >&2; exit 1; }
(cd "$(dirname "$SIF")" && sha256sum -c "$(basename "$SIF").sha256")

ml use /soft/modulefiles
ml spack-pe-base
ml cmake/3.30.5
ml ninja/1.12.1
ml apptainer
ml load cray-mpich
ml unload darshan
HOST_APPTAINER="$(command -v apptainer)"
HOST_MPIEXEC="$(command -v mpiexec)"
MPICXX="$(command -v CC)"
NVCC="$(command -v nvcc)"
CMAKE="$(command -v cmake)"
install -m 600 "$PBS_NODEFILE" "$RUNTIME/pbs_nodefile"
sort -u "$PBS_NODEFILE" >"$RUNTIME/hosts.unique"
test "$(wc -l < "$RUNTIME/hosts.unique")" -eq 2 || { printf 'ERROR: expected two hosts\n' >&2; exit 1; }

PROFILE_INPUT="$RUNTIME/environment-profile.txt"
{
  printf 'pbs_job_id=%s\nmpicxx=%s\nmpiexec=%s\nnvcc=%s\ncmake=%s\n' \
    "$JOB_ID" "$MPICXX" "$HOST_MPIEXEC" "$NVCC" "$CMAKE"
  sha256sum "$RUNTIME/pbs_nodefile"
  module list 2>&1
  "$MPICXX" --version 2>&1
  "$NVCC" --version 2>&1
} >"$PROFILE_INPUT"
export RED_SHIRT_ENV_PROFILE_ID="$(sha256sum "$PROFILE_INPUT" | cut -d' ' -f1)"

# Stage only immutable image-managed helpers into this attempt. The agent may
# create application files under TASK but cannot replace these probe programs.
HOST_BRIDGE="$TOOLS/red_shirt_host_bridge.sh"
HOST_WATCHER="$TOOLS/red_shirt_host_watcher.sh"
for helper in red_shirt_host_bridge.sh red_shirt_host_watcher.sh red_shirt_mpi_env.sh; do
  test -x "$TOOLS/$helper" || { printf 'ERROR: missing staged helper %s\n' "$helper" >&2; exit 1; }
done
install -m 0555 "$TOOLS/red_shirt_toolchain_stage.sh" "$ATTEMPT/red_shirt_toolchain_stage.sh"

# Production 8-rank path used by the Kokkos preflight and later by the bridge.
RUN8_LAUNCHER="$ATTEMPT/run8-launcher.sh"
cat >"$RUN8_LAUNCHER" <<'RUN8'
#!/bin/bash
set -euo pipefail
: "${RED_SHIRT_EXECUTABLE:?}"
: "${RED_SHIRT_OUTPUT_DIR:?}"
: "${RED_SHIRT_SIF:?}"
: "${RED_SHIRT_PBS_NODEFILE:?}"
: "${RED_SHIRT_RANK_WRAPPER:?}"
: "${RED_SHIRT_HOST_APPTAINER:?}"
: "${RED_SHIRT_HOST_MPIEXEC:?}"
: "${RED_SHIRT_PALS_RUNTIME_DIR:?}"
export APPTAINERENV_LD_LIBRARY_PATH="$RED_SHIRT_HOST_MPI_LD_LIBRARY_PATH:/hostlib64"
export APPTAINERENV_CRAY_LD_LIBRARY_PATH="$CRAY_LD_LIBRARY_PATH"
"$RED_SHIRT_HOST_MPIEXEC" --no-transfer --hostfile "$RED_SHIRT_PBS_NODEFILE" \
  -n 8 --ppn 4 --depth 8 --cpu-bind depth \
  "$RED_SHIRT_HOST_APPTAINER" exec --nv \
    --bind "$RED_SHIRT_ATTEMPT_ROOT:$RED_SHIRT_ATTEMPT_ROOT" \
    --bind "/opt/cray:/opt/cray:ro" --bind "/opt/nvidia:/opt/nvidia:ro" \
    --bind "/opt/cray/libfabric:/opt/cray/libfabric:ro" \
    --bind "/usr/lib64:/hostlib64:ro" --bind "/soft:/soft:ro" \
    --bind "$RED_SHIRT_PALS_RUNTIME_DIR:$RED_SHIRT_PALS_RUNTIME_DIR" \
    "$RED_SHIRT_SIF" "$RED_SHIRT_RANK_WRAPPER" "$RED_SHIRT_EXECUTABLE" "$RED_SHIRT_OUTPUT_DIR/run.ini"
RUN8
chmod 0555 "$RUN8_LAUNCHER"

# Switch to the accepted host/container ABI environment for rank launch.
# shellcheck source=../../scripts/red_shirt_mpi_env.sh
source "$MPI_ENV_HELPER"
export RED_SHIRT_SIF="$SIF" RED_SHIRT_PBS_NODEFILE="$RUNTIME/pbs_nodefile"
export RED_SHIRT_RANK_WRAPPER="$TOOLS/red_shirt_rank_wrapper.sh"
export RED_SHIRT_HOST_APPTAINER="$HOST_APPTAINER" RED_SHIRT_HOST_MPIEXEC="$HOST_MPIEXEC"
export RED_SHIRT_PALS_RUNTIME_DIR="$PALS_RUNTIME_DIR"
export RED_SHIRT_HOST_MPI_LD_LIBRARY_PATH="$HOST_MPI_LD_LIBRARY_PATH"
export RED_SHIRT_ATTEMPT_ROOT="$ATTEMPT"
export RED_SHIRT_RUN8_LAUNCHER="$RUN8_LAUNCHER"
export RED_SHIRT_PRODUCTION_RUNNER="$RUN8_LAUNCHER"
export RED_SHIRT_BRIDGE_DIR="$BRIDGE" RED_SHIRT_HOST_BRIDGE="$HOST_BRIDGE"
export RED_SHIRT_PROBE_WORKDIR="$PROBE_WORK"
export RED_SHIRT_MPICXX="$MPICXX" RED_SHIRT_MPIEXEC="$HOST_MPIEXEC"
export RED_SHIRT_PBS_NODEFILE="$RUNTIME/pbs_nodefile"
export RED_SHIRT_NVCC="$NVCC" RED_SHIRT_CMAKE="$CMAKE"
export RED_SHIRT_EXPECTED_RANKS=8 RED_SHIRT_EXPECTED_HOSTS=2

"$HOST_WATCHER" >"$RUNTIME/bridge-watcher.stdout" 2>"$RUNTIME/bridge-watcher.stderr" &
WATCHER_PID=$!
for _ in $(seq 1 20); do
  [ -e "$BRIDGE/READY" ] && break
  kill -0 "$WATCHER_PID" 2>/dev/null || { printf 'ERROR: watcher exited before READY\n' >&2; exit 19; }
  sleep 1
done
test -e "$BRIDGE/READY" || { printf 'ERROR: watcher readiness timeout\n' >&2; exit 19; }

# The reviewed preflight is staged into the attempt and exposed as evidence;
# Red Shirt chooses/installs candidate dependencies, then invokes this contract
# itself through the run_script bridge action. The orchestrator does not select
# Kokkos, install Pepper, or run the application preflight on its behalf.
install -m 0555 "$TOOLS/red_shirt_toolchain_preflight.py" "$ATTEMPT/red_shirt_toolchain_preflight.py"
python3 "$TOOLS/red_shirt_toolchain_manifest.py" \
  --attempt-root "$ATTEMPT" --stage-probe "$ATTEMPT/red_shirt_toolchain_stage.sh" \
  --output "$ATTEMPT/toolchain-manifest.json"

python3 - "$RUNTIME/facts.json" "$RED_SHIRT_ENV_PROFILE_ID" "$BRIDGE" "$TASK" "$RUNTIME" "$ATTEMPT" <<'PY'
import json,pathlib,sys
out,profile,bridge,task,runtime,attempt=sys.argv[1:]
payload={"environment_profile_id":profile,"allocation":{"ranks":8,"hosts":2,"gpus_per_host":4},
         "bridge":{"directory":bridge,"client":"/opt/red-shirt-polaris/red_shirt_host_client.sh",
                   "actions":["env_report","run_script","run8"]},
         "writable_roots":[task,runtime],
         "toolchain_preflight":{"manifest":attempt+"/toolchain-manifest.json",
                                "runner":attempt+"/red_shirt_toolchain_preflight.py",
                                "output":runtime+"/preflight/toolchain-preflight.json",
                                "status":"not_run"}}
pathlib.Path(out).write_text(json.dumps(payload,indent=2,sort_keys=True)+"\n")
PY

export APPTAINERENV_HERMES_HOME=/opt/data
export APPTAINERENV_HTTP_PROXY=http://proxy.alcf.anl.gov:3128
export APPTAINERENV_HTTPS_PROXY="$APPTAINERENV_HTTP_PROXY"
export APPTAINERENV_RED_SHIRT_BRIDGE_DIR="$BRIDGE"
export APPTAINERENV_RED_SHIRT_ENV_PROFILE_ID="$RED_SHIRT_ENV_PROFILE_ID"

"$HOST_APPTAINER" exec --cleanenv \
  --bind "$HERMES_HOME_DIR:/opt/data" --bind "$ATTEMPT:$ATTEMPT" \
  --bind "$BASE_DIR:$BASE_DIR" \
  "$SIF" python3 /opt/red-shirt-polaris/red_shirt_campaign.py \
    --task-root "$TASK" --runtime-root "$RUNTIME" \
    --facts-json "$RUNTIME/facts.json" \
    --prompt-file /opt/red-shirt-polaris/config/tasks/pepper-gpu-8rank.md \
    --context-generator /opt/red-shirt-polaris/red_shirt_task_context.py \
    --token-helper /opt/red-shirt-polaris/alcf_combined_auth.py \
    --probe /opt/red-shirt-polaris/red_shirt_probe.py \
    --base-url "${ALCF_BASE_URL:-https://inference-api.alcf.anl.gov/resource_server/sophia/vllm/v1}" \
    --model "${RED_SHIRT_PREFERRED_MODEL:-openai/gpt-oss-120b}" \
    --proxy http://proxy.alcf.anl.gov:3128 \
    --hermes-bin /opt/hermes/bin/hermes --hermes-timeout "$HERMES_TIMEOUT"
