#!/bin/bash
# probe-egress.pbs — Polaris compute-node egress probe
#
# PURPOSE
#   Run from a Polaris compute node to verify outbound HTTP/HTTPS connectivity
#   through the ALCF proxy.  Does NOT submit any external jobs.
#
# USAGE
#   Set ALCF_PROJECT and CACERT in your environment before submitting, e.g.:
#     export ALCF_PROJECT=myproject
#     export CACERT=/path/to/caddy-ca.crt   # private Caddy CA cert
#     qsub -A "$ALCF_PROJECT" deploy/polaris/probe-egress.pbs
#
#   CACERT is the path to the Caddy CA certificate that the Headscale/Caddy
#   reverse proxy presents.  It is NOT trusted in the Polaris system bundle,
#   so it must be staged and provided explicitly.
#
#   If CACERT is unset or the file is unreadable, the TLS probe is skipped
#   and tls_result is reported as SKIPPED.
#
# OUTPUT
#   Prints only: hostname / HTTP status / resolved address / TLS result /
#   tls_curl_rc / public IP.  No response headers, bodies, or secrets.
#
# NOTE: #PBS -A is intentionally absent — Polaris PBS does NOT expand shell
# variables inside directives, so "#PBS -A ${ALCF_PROJECT}" would submit
# under the literal string "${ALCF_PROJECT}" and be rejected.  Always pass
# the project with "qsub -A "$ALCF_PROJECT"" on the command line.
#
#PBS -N egress-probe
#PBS -l select=1:system=polaris
#PBS -q debug
#PBS -l walltime=00:10:00
#PBS -l filesystems=home

set -euo pipefail

# ---------------------------------------------------------------------------
# Proxy configuration (ALCF standard)
# ---------------------------------------------------------------------------
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128
export http_proxy=http://proxy.alcf.anl.gov:3128
export HTTPS_PROXY=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
HOSTNAME_VAL=$(hostname -f)

say() { printf '[probe] %s\n' "$*"; }

# ---------------------------------------------------------------------------
# 1. Negative control — direct connection (should FAIL on Polaris)
# ---------------------------------------------------------------------------
say "--- Negative control: direct curl (no proxy) ---"
say "hostname: ${HOSTNAME_VAL}"
DIRECT_STATUS=$(curl \
    --noproxy '*' \
    --silent \
    --connect-timeout 10 \
    --max-time 15 \
    --output /dev/null \
    --write-out '%{http_code}' \
    https://icanhazip.com 2>/dev/null || true)
say "direct_status: ${DIRECT_STATUS:-BLOCKED_OR_TIMEOUT}"

# ---------------------------------------------------------------------------
# 2. Proxied request — public IP discovery via icanhazip.com
# ---------------------------------------------------------------------------
say "--- Proxied curl: public IP via icanhazip.com ---"
PUBLIC_IP=$(curl \
    --proxy "${HTTPS_PROXY}" \
    --silent \
    --connect-timeout 15 \
    --max-time 20 \
    --output - \
    https://icanhazip.com 2>/dev/null | tr -d '[:space:]' || true)
say "public_ip: ${PUBLIC_IP:-UNAVAILABLE}"

# ---------------------------------------------------------------------------
# 3. Proxied TLS — sslip.io hostname with private Caddy CA cert
#
# Background:
#   - Polaris DNS sinkholes 143.198.112.69.sslip.io to a honeypot IP
#     (146.139.125.24), so we must not let curl resolve via DNS.
#   - The ALCF proxy CONNECT tunnel with the sslip.io hostname returns 503;
#     CONNECT with the numeric IP 143.198.112.69:443 returns 200.
#   - --connect-to HOST:PORT:IP:PORT forces curl to connect to the numeric
#     IP while keeping TLS SNI/hostname as the sslip.io name.
#   - The Caddy CA is private and not in the Polaris system trust store;
#     supply it via --cacert (never use -k / --insecure).
#
# tls_curl_rc is the curl exit code, captured separately so TLS handshake
# failures (curl exits non-zero) are distinguishable from HTTP-level errors.
# HTTP 000 alone does not prove a TLS failure.
# ---------------------------------------------------------------------------
say "--- Proxied TLS: https://143.198.112.69.sslip.io ---"

# Default: skip if CA file not provided or unreadable.
TLS_STATUS="000"
TLS_ADDR="unknown"
TLS_RESULT="SKIPPED"
tls_curl_rc=0

if [ -r "${CACERT:-}" ]; then
    say "cacert: ${CACERT} (readable)"
    # Run curl; capture exit code without triggering set -e.
    TLS_OUT=$(curl \
        --proxy "${HTTPS_PROXY}" \
        --silent \
        --connect-timeout 15 \
        --max-time 20 \
        --output /dev/null \
        --write-out '%{http_code} resolved=%{remote_ip}' \
        --connect-to 143.198.112.69.sslip.io:443:143.198.112.69:443 \
        --cacert "${CACERT}" \
        https://143.198.112.69.sslip.io 2>/dev/null) || tls_curl_rc=$?
    TLS_STATUS=$(printf '%s' "${TLS_OUT}" | awk '{print $1}')
    TLS_ADDR=$(printf '%s' "${TLS_OUT}" | awk '{print $2}')
    # TLS succeeds only if curl exited 0 AND we got a real HTTP status.
    if [ "${tls_curl_rc}" -eq 0 ] && [ "${TLS_STATUS:-000}" != "000" ]; then
        TLS_RESULT="OK"
    else
        TLS_RESULT="FAIL"
    fi
else
    say "cacert: CACERT not set or file not readable — TLS probe skipped"
    say "  To enable: export CACERT=/path/to/caddy-ca.crt"
fi

say "tls_status: ${TLS_STATUS:-000}"
say "tls_resolved: ${TLS_ADDR:-unknown}"
say "tls_curl_rc: ${tls_curl_rc}"
say "tls_result: ${TLS_RESULT}"

# ---------------------------------------------------------------------------
# Summary line
# ---------------------------------------------------------------------------
say "=== SUMMARY ==="
say "hostname:     ${HOSTNAME_VAL}"
say "direct_egress: ${DIRECT_STATUS:-BLOCKED_OR_TIMEOUT}"
say "public_ip:    ${PUBLIC_IP:-UNAVAILABLE}"
say "tls_status:   ${TLS_STATUS:-000}"
say "tls_resolved: ${TLS_ADDR:-unknown}"
say "tls_curl_rc:  ${tls_curl_rc}"
say "tls_result:   ${TLS_RESULT}"
