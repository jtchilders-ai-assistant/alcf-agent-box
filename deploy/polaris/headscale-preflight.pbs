#!/bin/bash
#PBS -N headscale-preflight
#PBS -l select=1:system=polaris
#PBS -q debug
#PBS -l walltime=00:20:00
#PBS -l filesystems=home
#
# Submit from the repository root with:
#   qsub -A datascience deploy/polaris/headscale-preflight.pbs
# Project selection belongs on qsub; PBS does not expand shell variables in directives.

set -euo pipefail

IMAGE="ghcr.io/jtchilders-ai-assistant/alcf-agent-headscale-probe:sha-e61a1b3"
EXPECTED_MANIFEST_DIGEST="sha256:157983581bf121b0cedcb2c45922f65e7e4bd6309b2ad69ee5c6389ecf20fc6e"
BASE_DIR="${BASE_DIR:-$HOME/polaris-headscale-preflight}"
SIF="${SIF:-$BASE_DIR/alcf-headscale-probe-sha-e61a1b3.sif}"
AUTH_KEY_FILE="${AUTH_KEY_FILE:-$BASE_DIR/headscale-auth.key}"
CA_FILE="${CA_FILE:-$BASE_DIR/caddy-root.crt}"
JOB_SHORT="${PBS_JOBID%%.*}"
SCRATCH_ROOT="/local/scratch/${USER}/headscale-preflight-${JOB_SHORT}"
STATE_DIR="$SCRATCH_ROOT/state"
RESULT_DIR="$BASE_DIR/results/${PBS_JOBID}"

cleanup_state() {
  rm -rf "$SCRATCH_ROOT"
}
trap cleanup_state EXIT

export HTTP_PROXY="http://proxy.alcf.anl.gov:3128"
export HTTPS_PROXY="$HTTP_PROXY"
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

check_credential_file() {
  local path="$1" label="$2" mode
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    printf 'ERROR: %s is not a readable regular file: %s\n' "$label" "$path" >&2
    exit 1
  fi
  mode=$(stat -c '%a' "$path")
  if [ "$mode" != "600" ]; then
    printf 'ERROR: %s must have mode 600, found %s: %s\n' "$label" "$mode" "$path" >&2
    exit 1
  fi
}

check_credential_file "$AUTH_KEY_FILE" "Headscale auth key"
check_credential_file "$CA_FILE" "Caddy root CA"

if [ ! -f "$SIF" ] || [ ! -r "$SIF" ]; then
  printf 'ERROR: SIF is missing; run deploy/polaris/build-probe-sif.sh first: %s\n' "$SIF" >&2
  exit 1
fi
if [ ! -f "${SIF}.sha256" ]; then
  printf 'ERROR: SIF checksum sidecar is missing: %s.sha256\n' "$SIF" >&2
  exit 1
fi
sha256sum -c "${SIF}.sha256"

mkdir -p "$STATE_DIR" "$RESULT_DIR"
chmod 700 "$STATE_DIR" "$RESULT_DIR"

{
  printf 'pbs_job_id=%s\n' "$PBS_JOBID"
  printf 'hostname=%s\n' "$(hostname)"
  printf 'source_image=%s\n' "$IMAGE"
  printf 'source_manifest_digest=%s\n' "$EXPECTED_MANIFEST_DIGEST"
  printf 'sif_sha256=%s\n' "$(sha256sum "$SIF" | cut -d' ' -f1)"
  apptainer --version
  apptainer exec "$SIF" tailscale version || true
} >"$RESULT_DIR/metadata.txt"

# APPTAINERENV_* carries only non-secret runtime configuration. The auth key is
# mounted read-only at the image's default file path; it is never in argv or env.
export APPTAINERENV_ALCF_PROXY="proxy.alcf.anl.gov:3128"
export APPTAINERENV_HTTP_PROXY="$HTTP_PROXY"
export APPTAINERENV_HTTPS_PROXY="$HTTPS_PROXY"
export APPTAINERENV_http_proxy="$http_proxy"
export APPTAINERENV_https_proxy="$https_proxy"

set +e
apptainer exec --cleanenv \
  --bind "$STATE_DIR:/tmp" \
  --bind "$BASE_DIR:/mnt:ro" \
  --env "AUTH_KEY_FILE=/mnt/headscale-auth.key" \
  --env "CA_FILE=/mnt/caddy-root.crt" \
  --env "TS_STATE_DIR=/tmp/ts-state" \
  "$SIF" /usr/local/bin/headscale_probe.sh \
  >"$RESULT_DIR/result.json" 2>"$RESULT_DIR/probe.stderr"
probe_rc=$?
set -e

printf 'probe_exit_code=%s\n' "$probe_rc" >>"$RESULT_DIR/metadata.txt"
json_rc=0
python3 -m json.tool "$RESULT_DIR/result.json" >/dev/null 2>&1 || json_rc=$?
printf 'result_json_valid=%s\n' "$([ "$json_rc" -eq 0 ] && printf true || printf false)" >>"$RESULT_DIR/metadata.txt"
if [ "$probe_rc" -ne 0 ]; then
  exit "$probe_rc"
fi
if [ "$json_rc" -ne 0 ]; then
  printf 'ERROR: probe exited successfully but result.json is invalid JSON\n' >&2
  exit 1
fi
exit "$probe_rc"
