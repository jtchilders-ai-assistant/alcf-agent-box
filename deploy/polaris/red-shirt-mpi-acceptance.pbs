#!/bin/bash
#PBS -N red-shirt-mpi-accept
#PBS -l select=2:system=polaris
#PBS -q debug
#PBS -l walltime=00:20:00
#PBS -l filesystems=home

set -euo pipefail

BASE_DIR="${BASE_DIR:-$HOME/red-shirt-polaris}"
HERMES_HOME_DIR="${HERMES_HOME_DIR:-$BASE_DIR/home}"
JOB_ID="${PBS_JOBID:-manual-$$}"
RUN_DIR="$HERMES_HOME_DIR/runs/$JOB_ID/mpi-acceptance"
TERMINAL_RECORD="$RUN_DIR/terminal.json"
SIF="${SIF:?Set SIF to the verified Red Shirt SIF path before submission}"
MPI_ENV_HELPER="${MPI_ENV_HELPER:-$BASE_DIR/red_shirt_mpi_env.sh}"

mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"

cleanup() {
  rc=$?
  set +e
  printf '{"exit_code":%s,"ok":%s,"pbs_job_id":"%s"}\n' \
    "$rc" "$([ "$rc" -eq 0 ] && printf true || printf false)" "$JOB_ID" \
    >"$TERMINAL_RECORD"
  chmod 600 "$TERMINAL_RECORD"
}
trap cleanup EXIT

# shellcheck source=../../scripts/red_shirt_mpi_env.sh
source "$MPI_ENV_HELPER"
install -m 600 "$PBS_NODEFILE" "$RUN_DIR/pbs_nodefile"
sha256sum "$RUN_DIR/pbs_nodefile" >"$RUN_DIR/pbs_nodefile.sha256"
sort -u "$PBS_NODEFILE" >"$RUN_DIR/hosts.unique"
if [ "$(wc -l < "$RUN_DIR/hosts.unique")" -ne 2 ]; then
  printf 'ERROR: expected exactly two allocated hosts\n' >&2
  exit 1
fi

{
  printf 'pbs_job_id=%s\n' "$JOB_ID"
  printf 'head_node=%s\n' "$(hostname)"
  printf 'hostfile=%s\n' "$PBS_NODEFILE"
  printf 'hostfile_sha256=%s\n' "$(sha256sum "$RUN_DIR/pbs_nodefile" | cut -d' ' -f1)"
  printf 'mpiexec=%s\n' "$HOST_MPIEXEC"
  printf 'apptainer=%s\n' "$HOST_APPTAINER"
  printf 'pals_runtime_dir=%s\n' "$PALS_RUNTIME_DIR"
  module list 2>&1
  "$HOST_MPIEXEC" --version 2>&1
  "$HOST_APPTAINER" --version 2>&1
} >"$RUN_DIR/environment.txt"

printf '%s\n' \
  '#include <mpi.h>' \
  '#include <stdio.h>' \
  '#include <unistd.h>' \
  'int main(int argc, char **argv) {' \
  '  int rank = -1, size = -1; char host[256] = {0};' \
  '  MPI_Init(&argc, &argv);' \
  '  MPI_Comm_rank(MPI_COMM_WORLD, &rank);' \
  '  MPI_Comm_size(MPI_COMM_WORLD, &size);' \
  '  gethostname(host, sizeof(host)-1);' \
  '  printf("rank=%d size=%d host=%s\\n", rank, size, host);' \
  '  fflush(stdout);' \
  '  MPI_Finalize();' \
  '  return 0;' \
  '}' >"$RUN_DIR/hello_mpi.c"

CC "$RUN_DIR/hello_mpi.c" -o "$RUN_DIR/hello_mpi" \
  >"$RUN_DIR/compile.stdout" 2>"$RUN_DIR/compile.stderr"
ldd "$RUN_DIR/hello_mpi" >"$RUN_DIR/ldd.txt"
if grep -q 'not found' "$RUN_DIR/ldd.txt"; then
  printf 'ERROR: unresolved native MPI libraries\n' >&2
  exit 1
fi

"$HOST_MPIEXEC" --hostfile "$PBS_NODEFILE" -n 2 --ppn 1 \
  "$RUN_DIR/hello_mpi" \
  >"$RUN_DIR/native.stdout" 2>"$RUN_DIR/native.stderr"

export APPTAINERENV_PATH="$HOST_MPI_PATH"
export APPTAINERENV_LD_LIBRARY_PATH="$HOST_MPI_LD_LIBRARY_PATH"
export APPTAINERENV_CRAY_LD_LIBRARY_PATH="$CRAY_LD_LIBRARY_PATH"

"$HOST_MPIEXEC" --hostfile "$PBS_NODEFILE" -n 2 --ppn 1 \
  "$HOST_APPTAINER" exec --cleanenv \
    --bind "$HERMES_HOME_DIR:/opt/data" \
    --bind "/opt/cray:/opt/cray:ro" \
    --bind "/opt/nvidia:/opt/nvidia:ro" \
    --bind "/opt/cray/libfabric:/opt/cray/libfabric:ro" \
    --bind "/soft:/soft:ro" \
    --bind "$PALS_RUNTIME_DIR:$PALS_RUNTIME_DIR:ro" \
    "$SIF" "/opt/data/runs/$JOB_ID/mpi-acceptance/hello_mpi" \
  >"$RUN_DIR/container.stdout" 2>"$RUN_DIR/container.stderr"

python3 - "$RUN_DIR" <<'PY'
import json
import pathlib
import re
import sys

run = pathlib.Path(sys.argv[1])
hosts = set((run / "hosts.unique").read_text().splitlines())
result = {"expected_hosts": sorted(hosts)}
for label in ("native", "container"):
    lines = (run / f"{label}.stdout").read_text().splitlines()
    records = []
    for line in lines:
        match = re.search(r"rank=(\d+) size=(\d+) host=(\S+)", line)
        if match:
            records.append({"rank": int(match.group(1)), "size": int(match.group(2)), "host": match.group(3)})
    ok = (
        {record["rank"] for record in records} == {0, 1}
        and {record["size"] for record in records} == {2}
        and {record["host"] for record in records} == hosts
    )
    result[label] = {"ok": ok, "records": records}
    if not ok:
        (run / "result.json").write_text(json.dumps(result, indent=2) + "\n")
        raise SystemExit(f"{label} rank placement did not match PBS_NODEFILE")
result["ok"] = True
(run / "result.json").write_text(json.dumps(result, indent=2) + "\n")
PY
