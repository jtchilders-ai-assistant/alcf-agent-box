#!/bin/bash
# red-shirt-polaris.pbs — Resident Red Shirt Polaris Hermes agent launcher.
#
# Design: docs/superpowers/specs/2026-09-16-red-shirt-polaris-design.md
# Plan:   docs/superpowers/plans/2026-09-16-red-shirt-polaris.md (Task 6)
#
# Submit from the repository root with an EXPLICIT project on the qsub
# command line -- PBS does not expand shell variables inside directives, so
# an allocation directive using an unexpanded variable would submit under
# the literal string and be rejected. The account is therefore selected
# ONLY at submit time, never baked into this file as a directive:
#
#   qsub -A datascience deploy/polaris/red-shirt-polaris.pbs
#
# See deploy/polaris/RED_SHIRT_README.md for staging, monitoring, failure
# handling, and teardown.
#
#PBS -N red-shirt-polaris
#PBS -l select=1:system=polaris
#PBS -q prod
#PBS -l walltime=12:00:00
#PBS -l filesystems=home

set -euo pipefail

# ---------------------------------------------------------------------------
# Layout (override any of these via a submit-time variable-list flag for
# NON-secret path overrides only -- never for credential values). Pure
# string composition -- no I/O, cannot fail.
# ---------------------------------------------------------------------------
BASE_DIR="${BASE_DIR:-$HOME/red-shirt-polaris}"
HERMES_HOME_DIR="${HERMES_HOME_DIR:-$BASE_DIR/home}"
SECRETS_DIR="${SECRETS_DIR:-$BASE_DIR/secrets}"
HEADSCALE_KEY_FILE="${HEADSCALE_KEY_FILE:-$SECRETS_DIR/headscale-auth.key}"
INBOUND_A2A_FILE="${INBOUND_A2A_FILE:-$SECRETS_DIR/inbound-a2a.token}"
OUTBOUND_A2A_FILE="${OUTBOUND_A2A_FILE:-$SECRETS_DIR/outbound-a2a.token}"
CA_FILE="${CA_FILE:-$SECRETS_DIR/caddy-root.crt}"

JOB_ID="${PBS_JOBID:-manual-$$}"
JOB_SHORT="${JOB_ID%%.*}"
RUN_DIR="$BASE_DIR/runs/$JOB_ID"
SCRATCH_ROOT="/local/scratch/${USER}/red-shirt-run-${JOB_SHORT}"
STATE_DIR="$SCRATCH_ROOT/state"
READY_RECORD="$RUN_DIR/ready.json"
TERMINAL_RECORD="$RUN_DIR/terminal.json"
APPTAINER_PID=""

log() { printf '[red-shirt-pbs] %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Create ONLY the persistent run directory and install the failure-recording
# trap before anything that can fail: module loads, the image-pin gate,
# credential validation, job-local scratch creation, and SIF checksum
# verification. Every one of those gates runs AFTER this point specifically
# so a failure at any of them still leaves a persistent terminal.json, not
# just a startup that got all the way to launching Apptainer.
# ---------------------------------------------------------------------------
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"

CLEANUP_DONE=""

# ---------------------------------------------------------------------------
# Signal handling. `trap cleanup EXIT INT TERM` alone is not signal-safe:
# bash defers delivery of a trapped signal until the current foreground
# command returns, so if that foreground command (e.g. a slow `ml` module
# load) happens to finish on its own right after the signal arrives, the
# single shared handler re-enters with `$?` set to the foreground command's
# own (successful) exit status -- NOT the signal -- and wrongly persists
# terminal.json with exit_code: 0 / ok: true. Dedicated INT/TERM handlers
# capture the fact that a signal was received and force a stable nonzero
# status (128+signum) into the record regardless of what `$?` happens to
# be when the handler actually runs. CLEANUP_DONE guards against running
# the body twice: a TERM/INT handler that itself calls `exit` re-enters the
# EXIT trap, and PBS/qdel can deliver more than one signal.
# ---------------------------------------------------------------------------
cleanup() {
  local rc="$1"
  if [ -n "$CLEANUP_DONE" ]; then
    return 0
  fi
  CLEANUP_DONE=1
  set +e
  if [ -n "$APPTAINER_PID" ] && kill -0 "$APPTAINER_PID" 2>/dev/null; then
    kill -TERM "$APPTAINER_PID" 2>/dev/null
    wait "$APPTAINER_PID" 2>/dev/null
  fi
  rm -rf -- "$SCRATCH_ROOT"
  printf '{"exit_code": %s, "ok": %s, "pbs_job_id": "%s"}\n' \
    "$rc" "$([ "$rc" -eq 0 ] && printf true || printf false)" "$JOB_ID" \
    >"$TERMINAL_RECORD"
  chmod 600 "$TERMINAL_RECORD" 2>/dev/null || true
}

on_exit() {
  cleanup "$?"
}

on_signal() {
  local sig_rc="$1"
  cleanup "$sig_rc"
  trap - EXIT INT TERM
  exit "$sig_rc"
}

trap on_exit EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

# ---------------------------------------------------------------------------
# Modules (verified order: use, then base, then apptainer)
# ---------------------------------------------------------------------------
ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

# Resolve the site MPI environment on the host. The container is a packaging
# boundary, not an execution sandbox: Red Shirt intentionally receives the
# user's direct host MPI capability within this PBS allocation.
MPI_ENV_HELPER="${MPI_ENV_HELPER:-$BASE_DIR/red_shirt_mpi_env.sh}"
if [ ! -r "$MPI_ENV_HELPER" ]; then
  printf 'ERROR: host MPI environment helper is missing: %s\n' "$MPI_ENV_HELPER" >&2
  exit 1
fi
# shellcheck source=../../scripts/red_shirt_mpi_env.sh
source "$MPI_ENV_HELPER"

export HTTP_PROXY="http://proxy.alcf.anl.gov:3128"
export HTTPS_PROXY="$HTTP_PROXY"
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"

# ---------------------------------------------------------------------------
# Image pin is resolved the same fail-closed way as the SIF builder in
# intent -- no default, no silent fallback to a stale or guessed artifact --
# but via explicit if/exit rather than bash's ${VAR:?msg} parameter
# expansion. Under this launcher's `set -euo pipefail` + EXIT trap, ${VAR:?msg}
# on an unset var does correctly abort the script, but the trap's `rc=$?`
# read on entry then loses the failing status (observed: reads 0 in this
# environment's bash), which corrupts terminal.json's exit_code/ok fields.
# An explicit `if [ -z ... ]; then ...; exit 1; fi` calls `exit` itself, so
# `$?` inside the trap is reliably the code passed to that exit call.
# ---------------------------------------------------------------------------
if [ -z "${RED_SHIRT_IMAGE:-}" ]; then
  printf 'ERROR: RED_SHIRT_IMAGE is not set. Export the CI-published image reference used to build the SIF before submitting.\n' >&2
  exit 1
fi
if [ -z "${RED_SHIRT_DIGEST:-}" ]; then
  printf 'ERROR: RED_SHIRT_DIGEST is not set. Export the CI-published sha256 manifest digest before submitting.\n' >&2
  exit 1
fi
SIF_TAG="$(printf '%s' "$RED_SHIRT_IMAGE" | sed 's/.*://')"
SIF="${SIF:-$BASE_DIR/red-shirt-polaris-${SIF_TAG}.sif}"

# ---------------------------------------------------------------------------
# Credential validation -- METADATA ONLY. Contents are never read, echoed,
# hashed, or logged here; the in-container config renderer (Task 3) is the
# only code that reads a credential's bytes, and it never prints them either.
# ---------------------------------------------------------------------------
check_credential_file() {
  local path="$1" label="$2" mode
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    printf 'ERROR: %s is not a readable regular file: %s\n' "$label" "$path" >&2
    exit 1
  fi
  mode=$(stat -c '%a' "$path")
  if [ "$mode" != "600" ]; then
    printf 'ERROR: %s must have mode 600, found %s: %s\n' "$label" "$mode" "$path" >&2
    exit 1
  fi
}

check_credential_file "$HEADSCALE_KEY_FILE" "Headscale join key"
check_credential_file "$INBOUND_A2A_FILE" "inbound A2A token (wesley -> red-shirt-polaris)"
check_credential_file "$OUTBOUND_A2A_FILE" "outbound A2A token (red-shirt-polaris -> wesley)"
check_credential_file "$CA_FILE" "Headscale/Caddy root CA"

mkdir -p "$HERMES_HOME_DIR" "$HERMES_HOME_DIR/runs/$JOB_ID" "$STATE_DIR"
chmod 700 "$STATE_DIR"

# Preserve the scheduler-provided host file exactly. Never reconstruct the
# allocation from hostnames or assume rank placement. This copy is both the
# in-container launch input and durable provenance after the PBS job exits.
test -f "$PBS_NODEFILE" && test -r "$PBS_NODEFILE" || {
  printf 'ERROR: PBS_NODEFILE is not a readable regular file: %s\n' "${PBS_NODEFILE:-<unset>}" >&2
  exit 1
}
install -m 600 "$PBS_NODEFILE" "$RUN_DIR/pbs_nodefile"
sha256sum "$RUN_DIR/pbs_nodefile" > "$RUN_DIR/pbs_nodefile.sha256"

# ---------------------------------------------------------------------------
# SIF checksum verification -- MUST happen before any execution. A qsub or
# qdel exit code alone is never sufficient evidence the artifact is intact.
# ---------------------------------------------------------------------------
if [ ! -f "$SIF" ] || [ ! -r "$SIF" ]; then
  printf 'ERROR: SIF is missing; run deploy/polaris/build-red-shirt-sif.sh first: %s\n' "$SIF" >&2
  exit 1
fi
if [ ! -f "${SIF}.sha256" ]; then
  printf 'ERROR: SIF checksum sidecar is missing: %s.sha256\n' "$SIF" >&2
  exit 1
fi
(cd "$(dirname "$SIF")" && sha256sum -c "$(basename "$SIF").sha256")

# ---------------------------------------------------------------------------
# Provenance metadata (non-secret) -- written before execution so it survives
# even a startup failure.
# ---------------------------------------------------------------------------
{
  printf 'pbs_job_id=%s\n' "$JOB_ID"
  printf 'hostname=%s\n' "$(hostname)"
  printf 'source_image=%s\n' "$RED_SHIRT_IMAGE"
  printf 'source_manifest_digest=%s\n' "$RED_SHIRT_DIGEST"
  printf 'sif_sha256=%s\n' "$(sha256sum "$SIF" | cut -d' ' -f1)"
  printf 'pbs_nodefile_source=%s\n' "$PBS_NODEFILE"
  printf 'pbs_nodefile_sha256=%s\n' "$(sha256sum "$RUN_DIR/pbs_nodefile" | cut -d' ' -f1)"
  printf 'host_mpiexec=%s\n' "$HOST_MPIEXEC"
  printf 'pals_runtime_dir=%s\n' "$PALS_RUNTIME_DIR"
  module list 2>&1
  apptainer --version
  apptainer exec "$SIF" hermes --version || true
  apptainer exec "$SIF" tailscale version || true
} >"$RUN_DIR/metadata.txt"

# APPTAINERENV_* carries only non-secret paths/config. Every credential is
# passed as a mounted read-only FILE PATH under /mnt/secrets, never a
# literal value, never argv, never a log line.
export APPTAINERENV_HOME="/opt/data"
export APPTAINERENV_HERMES_HOME="/opt/data"
export APPTAINERENV_RED_SHIRT_HOME="/opt/data"
export APPTAINERENV_RED_SHIRT_JOB_PARENT="/tmp"
export APPTAINERENV_RED_SHIRT_JOB_ROOT="/tmp/red-shirt-runtime"
export APPTAINERENV_RED_SHIRT_HEADSCALE_KEY_FILE="/mnt/secrets/headscale-auth.key"
export APPTAINERENV_RED_SHIRT_HEADSCALE_CA_FILE="/mnt/secrets/caddy-root.crt"
export APPTAINERENV_RED_SHIRT_INBOUND_A2A_FILE="/mnt/secrets/inbound-a2a.token"
export APPTAINERENV_RED_SHIRT_OUTBOUND_A2A_FILE="/mnt/secrets/outbound-a2a.token"
export APPTAINERENV_RED_SHIRT_TOKEN_HELPER="/opt/red-shirt-polaris/alcf_combined_auth.py"
export APPTAINERENV_RED_SHIRT_HEADSCALE_URL="https://143.198.112.69.sslip.io"
export APPTAINERENV_RED_SHIRT_PREFERRED_MODEL="openai/gpt-oss-120b"
export APPTAINERENV_RED_SHIRT_WESLEY_URL="http://100.64.0.2:9900/"
export APPTAINERENV_RED_SHIRT_TS_STATE_DIR="/tmp/ts-state"
export APPTAINERENV_RED_SHIRT_READY_OUTPUT="/opt/data/runs/${JOB_ID}/ready.json"
export APPTAINERENV_RED_SHIRT_TERMINAL_OUTPUT="/opt/data/runs/${JOB_ID}/terminal.json"
export APPTAINERENV_RED_SHIRT_ALCF_PROXY="proxy.alcf.anl.gov:3128"
export APPTAINERENV_RED_SHIRT_HOSTFILE="/opt/data/runs/${JOB_ID}/pbs_nodefile"
export APPTAINERENV_PBS_NODEFILE="$APPTAINERENV_RED_SHIRT_HOSTFILE"
export APPTAINERENV_RED_SHIRT_HOST_MPIEXEC="$HOST_MPIEXEC"
export APPTAINERENV_PATH="$HOST_MPI_PATH"
export APPTAINERENV_LD_LIBRARY_PATH="$HOST_MPI_LD_LIBRARY_PATH"
export APPTAINERENV_CRAY_LD_LIBRARY_PATH="$CRAY_LD_LIBRARY_PATH"
export APPTAINERENV_HTTP_PROXY="$HTTP_PROXY"
export APPTAINERENV_HTTPS_PROXY="$HTTPS_PROXY"
export APPTAINERENV_http_proxy="$http_proxy"
export APPTAINERENV_https_proxy="$https_proxy"

# Binds are restricted to destinations guaranteed present in the immutable
# SIF: /opt/data (WORKDIR, owned by the hermes user) and /tmp (universally
# present). Apptainer refuses a bind onto a path absent from a read-only
# SIF, so no destination outside this set is ever attempted.
set +e
apptainer run --cleanenv \
  --bind "$HERMES_HOME_DIR:/opt/data" \
  --bind "$SECRETS_DIR:/mnt/secrets:ro" \
  --bind "$STATE_DIR:/tmp" \
  --bind "/opt/cray:/opt/cray:ro" \
  --bind "/opt/nvidia:/opt/nvidia:ro" \
  --bind "/opt/cray/libfabric:/opt/cray/libfabric:ro" \
  --bind "/soft:/soft:ro" \
  --bind "$PALS_RUNTIME_DIR:$PALS_RUNTIME_DIR:ro" \
  "$SIF" \
  >"$RUN_DIR/stdout.log" 2>"$RUN_DIR/stderr.log" &
APPTAINER_PID=$!
set -e

log "started apptainer (pid $APPTAINER_PID); waiting for readiness/terminal records under $RUN_DIR"
wait "$APPTAINER_PID"
