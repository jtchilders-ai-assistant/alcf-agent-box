# Dockerfile.headscale-probe
#
# Minimal OCI image for the Headscale / Tailscale connectivity probe.
#
# What it does:
#   1. Copies tailscale + tailscaled binaries from the official pinned image.
#   2. Installs curl and ca-certificates for probe HTTP calls.
#   3. Bakes in scripts/connect_proxy.py and scripts/headscale_probe.sh.
#   4. Runs as uid 10000 (non-root, no CAP_NET_ADMIN needed for userspace mode).
#
# TLS notes:
#   • tailscaled runs in --tun=userspace-networking (no TUN fd, no CAP_NET_ADMIN).
#   • SSL_CERT_FILE is set by headscale_probe.sh to the mounted Caddy root CA,
#     so tailscaled trusts the private ALCF Caddy certificate without -k.
#   • The local connect_proxy.py rewrites CONNECT 143.198.112.69.sslip.io:443
#     → CONNECT 143.198.112.69:443 before forwarding to proxy.alcf.anl.gov:3128,
#     bypassing the Polaris sslip.io DNS sinkhole while preserving original TLS SNI.
#
# Usage:
#   docker run --rm \
#     -v /path/to/auth.key:/run/secrets/headscale-auth-key:ro \
#     -v /path/to/caddy-root.crt:/run/secrets/caddy-root.crt:ro \
#     ghcr.io/jtchilders-ai-assistant/alcf-agent-headscale-probe

# ---------------------------------------------------------------------------
# Stage 0: pull tailscale binaries from the pinned official image.
#
# Pin by BOTH tag AND sha256 for reproducibility.
# The sha256 here is for the multi-arch manifest; individual platform manifests
# are resolved by buildkit at build time.
# ---------------------------------------------------------------------------
FROM tailscale/tailscale:v1.88.3@sha256:b2a19f6b6402adc26a2aa8cb90da66afe3061e718ac67ed3f21ec3d4b366439f AS tailscale-src

# ---------------------------------------------------------------------------
# Stage 1: runtime image
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# Install curl and ca-certificates deterministically (no version wildcards).
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
         curl \
         ca-certificates \
         python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy tailscale binaries from the pinned source stage.
COPY --from=tailscale-src /usr/local/bin/tailscale  /usr/local/bin/tailscale
COPY --from=tailscale-src /usr/local/bin/tailscaled /usr/local/bin/tailscaled

# Bake in the probe scripts.
COPY scripts/connect_proxy.py /usr/local/bin/connect_proxy.py
COPY scripts/headscale_probe.sh /usr/local/bin/headscale_probe.sh
RUN chmod +x /usr/local/bin/headscale_probe.sh \
    && chmod +x /usr/local/bin/connect_proxy.py

# Create a non-root user/group.
RUN groupadd -g 10000 probe && useradd -u 10000 -g 10000 -s /bin/bash -m probe

# State directory writable by uid 10000.
RUN mkdir -p /tmp/ts-state && chown 10000:10000 /tmp/ts-state

WORKDIR /home/probe

# SSL_CERT_FILE will be overridden at runtime by headscale_probe.sh to point
# at the mounted Caddy root CA.  We declare it here so it is visible in
# image inspection and so callers can override it via -e without the script
# needing to re-export it from scratch.
ENV SSL_CERT_FILE=/run/secrets/caddy-root.crt

# Non-root uid — tailscaled userspace mode does not need CAP_NET_ADMIN.
USER 10000

ENTRYPOINT ["/usr/local/bin/headscale_probe.sh"]
